class Solution:
    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:
        dummy = ListNode(0)
        dummy.next = head
        prev = dummy

        # Tab tak loop chalega jab tak 2 nodes available hain swap ke liye
        while prev.next and prev.next.next:
            first = prev.next
            second = prev.next.next

            # Swapping start
            first.next = second.next

            # second ko firse jod denge
            second.next = first

            # prev ko second se jod denge
            prev.next = second
            
            # prev ko aage badhao (first pe le jao)
            # taaki next pair handle kar sake
            prev = first
        return dummy.next
